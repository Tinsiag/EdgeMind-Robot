// Wiring revision 2026-10-14: user-reported package balls, not connector pin numbers.
// Rebuild and audit routed pins/IO banks before use; old bitstreams are incompatible.
// ACG720 GW5AT-60B, 50 MHz, all control IO at 3.3 V.
IO_LOC "clk" Y18;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC "stop_n" F15;
IO_PORT "stop_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_rx" J21;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "uart_tx" M15;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=4;
IO_LOC "left_in1" A18; // 2026-10-14: L-1 / LAIN1; header pin unverified
IO_LOC "left_in2" A19; // 2026-10-14: L-2 / LAIN2; header pin unverified
IO_LOC "left_enc_a" A15; // 2026-10-14: L-7 / LF_ENA; header pin unverified
IO_LOC "left_enc_b" A16; // 2026-10-14: L-8 / LF_ENB; header pin unverified
IO_LOC "right_in1" F13; // 2026-10-14: R-5 / RAIN1; header pin unverified
IO_LOC "right_in2" F14; // 2026-10-14: R-6 / RAIN2; header pin unverified
IO_LOC "right_enc_a" E13; // 2026-10-14: R-2 / RF_ENA; header pin unverified
IO_LOC "right_enc_b" E14; // 2026-10-14: R-1 / RF_ENB; header pin unverified
IO_PORT "left_in1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4;
IO_PORT "left_in2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4;
IO_PORT "right_in1" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4;
IO_PORT "right_in2" IO_TYPE=LVCMOS33 PULL_MODE=DOWN DRIVE=4;
IO_PORT "left_enc_a" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "left_enc_b" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "right_enc_a" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_PORT "right_enc_b" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
IO_LOC "led[0]" M22;
IO_LOC "led[1]" N22;
IO_LOC "led[2]" L21;
IO_LOC "led[3]" K21;
IO_LOC "led[4]" K22;
IO_LOC "led[5]" J22;
IO_LOC "led[6]" H22;
IO_LOC "led[7]" M21;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "led[6]" IO_TYPE=LVCMOS33 DRIVE=4;
IO_PORT "led[7]" IO_TYPE=LVCMOS33 DRIVE=4;
