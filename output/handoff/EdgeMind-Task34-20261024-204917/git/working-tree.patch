diff --git a/code/camera-car-control/a741-fpga-fusion/host/fusion.py b/code/camera-car-control/a741-fpga-fusion/host/fusion.py
index 96ca3f4..8bfc77e 100644
--- a/code/camera-car-control/a741-fpga-fusion/host/fusion.py
