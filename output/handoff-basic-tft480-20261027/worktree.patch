-                sum += map->pixels[y * map->size_pixels + x];
-                npoints++;
-            } 
-        }
-    } 
-
-    /* Return sum scaled by number of points, or -1 if none */
-    return npoints ? (int)(sum * 1024 / npoints) : -1;  
-}
