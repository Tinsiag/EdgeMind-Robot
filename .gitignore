# Keep other manufacturer-supplied packages local. User-selected mechanical
# models are explicitly included under model/hardware/.
/doc/电机/WHEELTEC 直流电机附送资料/
/doc/fpga/**
!/doc/fpga/**/
!/doc/fpga/*.md
